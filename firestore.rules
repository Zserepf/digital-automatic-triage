rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Clinic staff can read any user profile
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'clinic_staff';
    }

    // Symptom logs
    match /symptomLogs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'clinic_staff'
      );
      allow update, delete: if request.auth != null && resource.data.studentId == request.auth.uid;
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'clinic_staff'
      );
      allow update: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'clinic_staff'
      );
      allow delete: if request.auth != null && resource.data.studentId == request.auth.uid;
    }

    // Consultations
    match /consultations/{consultationId} {
      allow create: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'clinic_staff';
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'clinic_staff'
      );
      allow update: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'clinic_staff';
    }

    // Emergency alerts
    match /emergencies/{emergencyId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'clinic_staff'
      );
    }

    // Follow-ups
    match /followUps/{followUpId} {
      allow create: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'clinic_staff';
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'clinic_staff'
      );
      allow update: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'clinic_staff'
      );
    }
  }
}
